{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "Device",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "The device ID must match the battery key in the EOS configuration (devices/batteries/<id>)."
                },
                {
                    "type": "ValidationTextBox",
                    "name": "DeviceID",
                    "caption": "EOS device ID",
                    "validate": "^[A-Za-z0-9_-]+$"
                },
                {
                    "type": "SelectVariable",
                    "name": "SoCSourceVariable",
                    "caption": "State of charge source variable",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "Select",
                    "name": "SoCUnit",
                    "caption": "Unit of the source variable",
                    "options": [
                        {
                            "caption": "Percent (0-100)",
                            "value": 0
                        },
                        {
                            "caption": "Factor (0-1)",
                            "value": 1
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "PushInterval",
                    "caption": "Push interval (s)",
                    "minimum": 0,
                    "maximum": 3600,
                    "suffix": " s"
                },
                {
                    "type": "Label",
                    "caption": "EOS rejects state of charge values older than 300 s (optimization.genetic.measurement_max_age_seconds). Keep the push interval well below that."
                },
                {
                    "type": "NumberSpinner",
                    "name": "PushDebounce",
                    "caption": "Minimum gap between change-triggered pushes (s)",
                    "minimum": 0,
                    "maximum": 300,
                    "suffix": " s"
                },
                {
                    "type": "NumberSpinner",
                    "name": "StaleAfterMinutes",
                    "caption": "Mark plan stale after (min)",
                    "minimum": 5,
                    "maximum": 1440,
                    "suffix": " min"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Control",
            "expanded": false,
            "items": [
                {
                    "type": "Select",
                    "name": "ControlMode",
                    "caption": "Control mode",
                    "options": [
                        {
                            "caption": "Display only (no control)",
                            "value": 0
                        },
                        {
                            "caption": "Simulation (log only, write nothing)",
                            "value": 1
                        },
                        {
                            "caption": "Active (write to the device)",
                            "value": 2
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Three options drive the device. All are optional and can be combined; on a change they run in order 1, 2, 3. Values are written only when they change, the action per mode runs once when entering the mode."
                },
                {
                    "type": "ExpansionPanel",
                    "caption": "Option 1: write values to variables on mode change",
                    "expanded": true,
                    "items": [
                        {
                            "type": "SelectVariable",
                            "name": "TargetModeVariable",
                            "caption": "Mode variable (value per EOS mode from the table below)",
                            "requiredAction": 1,
                            "onChange": "IPS_RequestAction($id, 'SetActionTarget', json_encode(['target' => $ActionTarget, 'modeVar' => $TargetModeVariable]));"
                        },
                        {
                            "type": "SelectVariable",
                            "name": "TargetChargePowerVariable",
                            "caption": "Charge power setpoint (W, grid charging)",
                            "requiredAction": 1,
                            "validVariableTypes": [
                                1,
                                2
                            ]
                        },
                        {
                            "type": "SelectVariable",
                            "name": "TargetDischargePowerVariable",
                            "caption": "Discharge power limit (W, 0 = no discharge)",
                            "requiredAction": 1,
                            "validVariableTypes": [
                                1,
                                2
                            ]
                        },
                        {
                            "type": "SelectVariable",
                            "name": "TargetDischargeAllowedVariable",
                            "caption": "Discharge allowed (bool)",
                            "requiredAction": 1,
                            "validVariableTypes": [
                                0
                            ]
                        },
                        {
                            "type": "SelectVariable",
                            "name": "TargetGridChargeVariable",
                            "caption": "Grid charging (bool)",
                            "requiredAction": 1,
                            "validVariableTypes": [
                                0
                            ]
                        },
                        {
                            "type": "List",
                            "name": "ModeMap",
                            "caption": "Value per EOS mode for the mode variable",
                            "rowCount": 7,
                            "add": false,
                            "delete": false,
                            "columns": [
                                {
                                    "name": "mode",
                                    "caption": "EOS",
                                    "width": "170px",
                                    "visible": true,
                                    "save": true
                                },
                                {
                                    "name": "caption",
                                    "caption": "Meaning",
                                    "width": "160px"
                                },
                                {
                                    "name": "value",
                                    "caption": "Value for the mode variable",
                                    "width": "auto",
                                    "add": "",
                                    "edit": {
                                        "type": "ValidationTextBox"
                                    }
                                }
                            ],
                            "values": []
                        }
                    ]
                },
                {
                    "type": "ExpansionPanel",
                    "name": "ModeActions",
                    "caption": "Option 2: run an instance action per EOS mode",
                    "expanded": false,
                    "items": [
                        {
                            "type": "SelectObject",
                            "name": "ActionTarget",
                            "caption": "Target of the actions (variable or instance, also for option 3; default: the mode variable)",
                            "onChange": "IPS_RequestAction($id, 'SetActionTarget', json_encode(['target' => $ActionTarget, 'modeVar' => $TargetModeVariable]));"
                        },
                        {
                            "type": "Label",
                            "caption": "Each action runs once when EOS switches into that mode. The picker opens with the target above and lists its actions."
                        }
                    ]
                },
                {
                    "type": "ExpansionPanel",
                    "caption": "Option 3: run an instance action or script on every EOS mode change",
                    "expanded": false,
                    "items": [
                        {
                            "type": "SelectAction",
                            "name": "ChangeAction",
                            "caption": "Action on every change"
                        },
                        {
                            "type": "SelectScript",
                            "name": "ControlScript",
                            "caption": "Script on every change ($_IPS parameters, see README)"
                        }
                    ]
                },
                {
                    "type": "ExpansionPanel",
                    "caption": "Fallback and safety",
                    "expanded": false,
                    "items": [
                        {
                            "type": "Select",
                            "name": "FallbackMode",
                            "caption": "Fallback mode (plan stale or expired)",
                            "options": [
                                {
                                    "caption": "No intervention",
                                    "value": -1
                                },
                                {
                                    "caption": "Locked",
                                    "value": 0
                                },
                                {
                                    "caption": "Self consumption",
                                    "value": 1
                                },
                                {
                                    "caption": "PV charging only",
                                    "value": 2
                                },
                                {
                                    "caption": "Discharge only",
                                    "value": 3
                                }
                            ]
                        },
                        {
                            "type": "CheckBox",
                            "name": "AllowGridCharge",
                            "caption": "Allow grid charging (otherwise GRID_SUPPORT_IMPORT / FORCED_CHARGE become PV charging only)"
                        },
                        {
                            "type": "CheckBox",
                            "name": "AllowGridExport",
                            "caption": "Allow grid export from the battery (otherwise GRID_SUPPORT_EXPORT becomes self consumption)"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "HeartbeatSeconds",
                            "caption": "Re-send setpoints every (s), 0 = off",
                            "minimum": 0,
                            "maximum": 3600,
                            "suffix": " s"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ManualReturnMinutes",
                            "caption": "Manual mode returns to automatic after (min), 0 = never",
                            "minimum": 0,
                            "maximum": 1440,
                            "suffix": " min"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ReleaseOnDisable",
                            "caption": "Write the fallback once when control is switched off"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Battery parameters (EOS device configuration)",
            "expanded": false,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "CapacityWh",
                    "caption": "Capacity (Wh)",
                    "minimum": 100,
                    "suffix": " Wh"
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxChargePowerW",
                    "caption": "Max. charge power (W)",
                    "minimum": 0,
                    "suffix": " W"
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxDischargePowerW",
                    "caption": "Max. discharge power (W)",
                    "minimum": 0,
                    "suffix": " W"
                },
                {
                    "type": "NumberSpinner",
                    "name": "MinSoC",
                    "caption": "Min. SoC (%)",
                    "minimum": 0,
                    "maximum": 100,
                    "suffix": " %"
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxSoC",
                    "caption": "Max. SoC (%)",
                    "minimum": 0,
                    "maximum": 100,
                    "suffix": " %"
                },
                {
                    "type": "NumberSpinner",
                    "name": "ChargingEfficiency",
                    "caption": "Charging efficiency (0-1)",
                    "digits": 2,
                    "minimum": 0.1,
                    "maximum": 1
                },
                {
                    "type": "NumberSpinner",
                    "name": "DischargingEfficiency",
                    "caption": "Discharging efficiency (0-1)",
                    "digits": 2,
                    "minimum": 0.1,
                    "maximum": 1
                },
                {
                    "type": "NumberSpinner",
                    "name": "LcosAmtKwh",
                    "caption": "Levelized cost of storage (EUR/kWh)",
                    "digits": 3,
                    "minimum": 0
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Take over values from EOS (fill form)",
                            "onClick": "EOSBAT_ReadConfigFromEOS($id);"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "ConfigInfo",
                    "caption": " "
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Push SoC now",
                    "onClick": "EOSBAT_PushSoC($id);"
                },
                {
                    "type": "Button",
                    "caption": "Refresh plan",
                    "onClick": "EOSBAT_RefreshPlan($id);"
                },
                {
                    "type": "Button",
                    "caption": "Apply control now",
                    "onClick": "EOSBAT_ApplyControl($id, true);"
                }
            ]
        },
        {
            "type": "Label",
            "name": "ActionResult",
            "caption": " "
        },
        {
            "type": "Label",
            "name": "ControlResult",
            "caption": " "
        }
    ],
    "status": [
        {
            "code": 101,
            "icon": "inactive",
            "caption": "Instance is being created"
        },
        {
            "code": 102,
            "icon": "active",
            "caption": "Active"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "No active EOS Server"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Device ID missing or invalid"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "State of charge source variable missing"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Device ID already used by another instance"
        }
    ]
}
