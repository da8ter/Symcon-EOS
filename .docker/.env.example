# Kopie nach .env anlegen (macht setup.sh automatisch) und Werte anpassen.

# Wird von setup.sh gesetzt: fertiges Image akkudoktor/eos:<EOS_VERSION> von Docker Hub (nur wenn
# EOS_GIT_REF zur Version passt) oder akkudoktor/eos:<EOS_VERSION>-local für den Build aus EOS_GIT_REF.
# EOS_IMAGE=akkudoktor/eos:0.4.0rc1-local
# Eigenes Image erzwingen (z. B. ein selbst gebautes): setup.sh übernimmt es unverändert.
# EOS_IMAGE_OVERRIDE=

# Git-Tag/Branch/Commit von https://github.com/Akkudoktor-EOS/EOS, aus dem gebaut wird.
EOS_GIT_REF=v0.4.0rc1
# Versionsstring für Image-Tag und Build-Label (ohne führendes "v").
EOS_VERSION=0.4.0rc1
# Python-Basisimage, muss zur Dockerfile-Vorgabe des Tags passen.
PYTHON_VERSION=3.13.15

# Ports auf dem Mac. Ändern, falls belegt (z. B. 8505/8506).
EOS_SERVER__PORT=8503
EOS_SERVER__EOSDASH_PORT=8504

# Session-Schlüssel für EOSdash. setup-mac.sh erzeugt einen zufälligen Wert.
EOSDASH_SESSKEY=change-me

# Zeitzone des Containers (EOS selbst rechnet mit der Zeitzone aus den Koordinaten).
TZ=Europe/Berlin
